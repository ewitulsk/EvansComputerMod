# Environment of the production stack. Copy to /opt/ecm-repo/.env on the
# droplet, fill in, and keep it private:  chmod 600 .env
# Never commit the real file. docs/DEPLOY.md explains every value.
#
# Format: KEY=value, no quotes, no spaces around "=". Do not use "$" in a
# value (docker compose would try to expand it).

# --- Image -------------------------------------------------------------------
# ghcr.io/<owner in lower case>/ecm-repo-backend
IMAGE=ghcr.io/ewitulsk/ecm-repo-backend
# A branch name (main) or a commit SHA. deploy.sh <tag> rewrites this line.
IMAGE_TAG=main

# Read-only login for a private image: a classic personal access token with
# only the read:packages scope. Leave both empty when the package is public
# or when CI logs the droplet in (secret GHCR_READ_TOKEN).
GHCR_USER=
GHCR_READ_TOKEN=

# --- Site --------------------------------------------------------------------
DOMAIN=repo.evanwitulski.com
PUBLIC_ORIGIN=https://repo.evanwitulski.com
# Let's Encrypt sends expiry warnings here.
ACME_EMAIL=

# --- Both services -----------------------------------------------------------
# Shared secret of /internal/* (at least 16 characters):  openssl rand -hex 32
INTERNAL_SECRET=

# --- auth-api ----------------------------------------------------------------
# log (prints mails to the container log), resend or postmark.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
# Must be an address on the domain you verified with the provider. A display
# name is allowed: ECM packages <noreply@evanwitulski.com>
EMAIL_FROM=noreply@evanwitulski.com
# Comma-separated. These accounts are admins once their e-mail is confirmed.
# Checked at every token lookup, so an address can be added later (then
# ./deploy.sh, which restarts auth-api).
ADMIN_EMAILS=

# --- repo-api ----------------------------------------------------------------
# 64 hex digits, the ed25519 seed the repository signs with. Make one with
#   docker run --rm <IMAGE>:<IMAGE_TAG> repo-api admin keygen
# (prints this line and the public key) or with: openssl rand -hex 32
# Keep a copy somewhere safe. The mod pins the matching PUBLIC key; losing or
# changing this value breaks every installed client.
REPO_SIGNING_KEY=

STORAGE=s3
# Terraform outputs "env_hints" prints the next three.
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_BUCKET=
# The droplet's Spaces key (limited to the two buckets, read/write/delete).
S3_ACCESS_KEY=
S3_SECRET_KEY=
# auto (bucket.host for *.digitaloceanspaces.com, host/bucket otherwise),
# true (always host/bucket) or false (always bucket.host). If Spaces rejects
# the signature, try S3_REGION=us-east-1 or S3_PATH_STYLE=true.
S3_PATH_STYLE=auto

MAX_PACKAGE_BYTES=8388608
ACCOUNT_QUOTA_BYTES=209715200
# Caddy's body limit on /v1/publish. Keep it a little above MAX_PACKAGE_BYTES.
PUBLISH_BODY_LIMIT=8454144

# --- Litestream --------------------------------------------------------------
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=https://nyc3.digitaloceanspaces.com
LITESTREAM_REGION=nyc3
# Normally the same key as S3_ACCESS_KEY / S3_SECRET_KEY.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# --- Container user ----------------------------------------------------------
# Numeric ids the services and Litestream run as, and the owner of ./data.
# Must match app_uid in infra/terraform (default 10001).
APP_UID=10001
APP_GID=10001

# --- Set by docker-compose.yml, listed here only for reference ---------------
# These are in the contract (docs/REPO_API.md) but fixed by the compose file;
# setting them here has no effect.
#   LISTEN             0.0.0.0:8081 (auth-api), 0.0.0.0:8082 (repo-api)
#   DATABASE_PATH      /data/auth.db (auth-api), /data/repo.db (repo-api)
#   AUTH_INTERNAL_URL  http://auth-api:8081
#   STORAGE_DIR        /data/blobs (only used when STORAGE=fs)
#   TRUST_PROXY        true (the services sit behind Caddy and take the client
#                      address from the last entry of X-Forwarded-For)
