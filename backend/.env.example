# Every variable the two services read (docs/REPO_API.md, "Storage and
# configuration"). The services read the process environment; they do not
# load this file themselves. For `cargo run`:
#
#   set -a; . ./.env; set +a
#
# Values here suit running both services with cargo on one machine.

# ---- both services -------------------------------------------------------

# The public origin, as browsers and the game see it. Links in mails and the
# device flow use it; cookies are `Secure` when it starts with https://.
PUBLIC_ORIGIN=http://localhost:8080

# Shared secret for /internal/* (at least 16 characters). Same in both.
INTERNAL_SECRET=change-me-to-a-long-random-string

# true only behind the proxy (Caddy): then the client address for rate limits
# is the last entry of X-Forwarded-For. Leave false when clients connect directly.
TRUST_PROXY=false

# LISTEN and DATABASE_PATH are read by both, with different values. Defaults:
#   auth-api: LISTEN=0.0.0.0:8081  DATABASE_PATH=/data/auth.db
#   repo-api: LISTEN=0.0.0.0:8082  DATABASE_PATH=/data/repo.db
# Set them per process (see README.md), not here, when both run from one shell.
#LISTEN=
#DATABASE_PATH=

# ---- auth-api ------------------------------------------------------------

# log (print mails to stdout), resend or postmark.
EMAIL_PROVIDER=log
# The provider's API key (resend, postmark).
EMAIL_API_KEY=
EMAIL_FROM=ECM packages <noreply@localhost>
# Comma-separated. These accounts are admins once their email is confirmed.
ADMIN_EMAILS=

# ---- repo-api ------------------------------------------------------------

# Where auth-api answers /internal/introspect.
AUTH_INTERNAL_URL=http://127.0.0.1:8081

# 64 hex digits: the ed25519 seed the repository signs with. Make one with
# `repo-api admin keygen`; print its public half with `repo-api admin pubkey`.
REPO_SIGNING_KEY=

# fs or s3.
STORAGE=fs
# For fs: the directory of package files.
STORAGE_DIR=./data/blobs
# For s3 (DigitalOcean Spaces, MinIO, AWS):
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# auto (bucket.host for *.digitaloceanspaces.com and *.amazonaws.com, host/bucket
# otherwise), true (always host/bucket) or false (always bucket.host).
S3_PATH_STYLE=auto

# Limits, in bytes. Defaults: 8 MiB a package, 200 MiB an account.
MAX_PACKAGE_BYTES=8388608
ACCOUNT_QUOTA_BYTES=209715200
