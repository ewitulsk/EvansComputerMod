          ],
          "code": "terminal.println({text})"
        },
        {
          "name": "clear",
          "label": "Clear Screen",
          "inputs": [
            {"name": "flow", "type": "flow"}
          ],
          "outputs": [
            {"name": "flow", "type": "flow"}
          ],
          "code": "terminal.clear()"
        }
      ]
    },
    {
      "name": "Timing",
      "color": "#2196F3",
      "blocks": [
        {
          "name": "sleep",
          "label": "Sleep",
          "inputs": [
            {"name": "flow", "type": "flow"},
            {"name": "seconds", "type": "number", "default": "1.0"}
          ],
          "outputs": [
            {"name": "flow", "type": "flow"}
          ],
          "code": "terminal.sleep({seconds})"
        }
      ]
    },
    {
      "name": "Redstone",
      "color": "#F44336",
      "blocks": [
        {
          "name": "set_redstone",
          "label": "Set Redstone",
          "inputs": [
            {"name": "flow", "type": "flow"},
            {"name": "side", "type": "number", "default": "0"},
            {"name": "power", "type": "number", "default": "15"}
          ],
          "outputs": [
            {"name": "flow", "type": "flow"}
          ],
          "code": "terminal.set_redstone({side}, {power})"
        }
      ]
    },
    {
      "name": "Peripheral",
      "color": "#FF9800",
      "blocks": [
        {
          "name": "find_peripheral",
          "label": "Find Peripheral",
          "inputs": [
            {"name": "flow", "type": "flow"},
            {"name": "type", "type": "string", "default": "chat_box"}
          ],
          "outputs": [
            {"name": "flow", "type": "flow"},
            {"name": "result", "type": "string"}
          ],
          "code": "{result} = peripheral.find({type})"
        },
        {
          "name": "call_peripheral",
          "label": "Call Peripheral",
          "inputs": [
            {"name": "flow", "type": "flow"},
            {"name": "name", "type": "string", "default": ""},
            {"name": "method", "type": "string", "default": ""},
            {"name": "args", "type": "string", "default": ""}
          ],
          "outputs": [
            {"name": "flow", "type": "flow"},
            {"name": "result", "type": "any"}
          ],
          "code": "{result} = peripheral.call({name}, {method}, {args})"
        }
      ]
    },
