{
  "multipart": [
    {
      "apply": {
        "model": "evanscomputermod:block/insulator_center"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/insulator_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/insulator_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/insulator_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/insulator_east"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/insulator_down"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/insulator_up"
      }
    }
  ]
}
