{
  "multipart": [
    {
      "apply": {
        "model": "evanscomputermod:block/hardline_center"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/hardline_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/hardline_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/hardline_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/hardline_east"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/hardline_down"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/hardline_up"
      }
    }
  ]
}
