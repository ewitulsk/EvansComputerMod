{
  "multipart": [
    {
      "apply": {
        "model": "evanscomputermod:block/fiber_span_center"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/fiber_span_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/fiber_span_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/fiber_span_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/fiber_span_east"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/fiber_span_down"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/fiber_span_up"
      }
    }
  ]
}
