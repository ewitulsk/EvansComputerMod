{
  "multipart": [
    {
      "apply": { "model": "evanscomputermod:block/network_cable_center" }
    },
    {
      "when": { "north": "true" },
      "apply": { "model": "evanscomputermod:block/network_cable_side", "y": 180 }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "evanscomputermod:block/network_cable_side" }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "evanscomputermod:block/network_cable_side", "y": 90 }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "evanscomputermod:block/network_cable_side", "y": 270 }
    },
    {
      "when": { "up": "true" },
      "apply": { "model": "evanscomputermod:block/network_cable_side_vertical", "x": 180 }
    },
    {
      "when": { "down": "true" },
      "apply": { "model": "evanscomputermod:block/network_cable_side_vertical" }
    }
  ]
}
