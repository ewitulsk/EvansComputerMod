{
  "multipart": [
    {
      "apply": {
        "model": "evanscomputermod:block/lattice_mast_center"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/lattice_mast_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/lattice_mast_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/lattice_mast_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/lattice_mast_east"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/lattice_mast_down"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "evanscomputermod:block/lattice_mast_up"
      }
    }
  ]
}
